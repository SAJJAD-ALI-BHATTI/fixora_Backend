PORT=5000
MONGO_URI=your_mongodb_connection_string
JWT_SECRET=your_jwt_secret
CLIENT_URL=http://localhost:5173
FRONTEND_URL=http://localhost:5173
IMAGEKIT_PUBLIC_KEY=your_imagekit_public_key
IMAGEKIT_PRIVATE_KEY=your_imagekit_private_key
IMAGEKIT_URL_ENDPOINT=your_imagekit_url_endpoint
PLATFORM_COMMISSION_PERCENT=10
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email
SMTP_PASS=your_app_password
SMTP_FROM=your_email
CONTACT_RECEIVER_EMAIL=your_email

# Vercel production:
# CLIENT_URL=https://fixora-frontend-ch0b5gk4g-devs-learners.vercel.app
# FRONTEND_URL=https://fixora-frontend-ch0b5gk4g-devs-learners.vercel.app

# Customer wallet deposits (Meezan Bank). Set real details before enabling bank deposits.
MEEZAN_ACCOUNT_TITLE=Your registered account title
MEEZAN_ACCOUNT_NUMBER=Your Meezan Bank account number
MEEZAN_IBAN=PK00XXXX0000000000000000
MEEZAN_BRANCH=Your branch name

# Optional: secret used to sign report reference numbers (defaults to JWT_SECRET)
REPORT_SECRET=change_me_long_random_string


# First admin account — used only by `npm run seed`. Choose your own values;
# the password needs 12+ chars with upper, lower, number and symbol.
# Remove ADMIN_PASSWORD from .env once the admin has been created.
ADMIN_NAME=Your Name
ADMIN_EMAIL=you@yourdomain.com
ADMIN_PASSWORD=

# Optional: extra allowed frontend URLs, comma-separated (e.g. preview deployments)
# ALLOWED_ORIGINS=
# Optional: wildcard origin patterns — a single leading * is supported
# e.g. *.vercel.app allows all Vercel preview deployments (useful during development)
# ALLOWED_ORIGIN_PATTERNS=*.vercel.app
